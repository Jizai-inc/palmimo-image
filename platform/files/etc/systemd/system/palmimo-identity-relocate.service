[Unit]
Description=Relocate Palmimo device identity
After=palmimo-firstboot.service
Before=palmimo-portal.service
RequiresMountsFor=/boot/firmware
ConditionPathExists=/boot/firmware/palmimo-identity.json

[Service]
Type=oneshot
TimeoutStartSec=60
RemainAfterExit=no
User=root
ExecStart=/usr/lib/palmimo/identity-relocate

[Install]
WantedBy=multi-user.target
