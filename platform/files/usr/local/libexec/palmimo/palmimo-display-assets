#!/usr/bin/python3
"""Convert display assets and validate the untrusted binary format before installation."""

from __future__ import annotations

import argparse
import json
import math
import os
import re
import struct
import sys
import tempfile
import warnings
import zlib
from array import array
from itertools import pairwise
from pathlib import Path
from typing import Any, BinaryIO, Never


SID = re.compile(r"[a-z0-9_]{1,32}", re.ASCII)
VECTORS = ("s", "e", "ox", "oy", "ix", "iy")
MAX_FILE = 6_275_072
MAX_KEYS = 2048
MAX_TRACKS = 256
MAX_COMPONENTS = 144
MAX_SOURCE_BYTES = 16 * 1024 * 1024
MAX_JSON_TOKENS = 1_000_000
MAX_JSON_DEPTH = 64


class AssetError(ValueError):
    def __init__(self, code: str, path: str, message: str) -> None:
        super().__init__(message)
        self.errors = [{"code": code, "path": path, "message": message}]


def require(condition: bool, code: str, path: str, message: str) -> None:
    if not condition:
        raise AssetError(code, path, message)


def bounded(value: Any, low: float, high: float) -> bool:
    return (
        isinstance(value, (float, int))
        and not isinstance(value, bool)
        and math.isfinite(value)
        and low <= value <= high
    )


def evaluate_track(track: dict[str, Any], time: float, left: bool = False) -> list[float]:
    keys = track["keys"]
    key = keys[0]
    for candidate in keys:
        if candidate["t"] > time or (left and candidate["t"] == time):
            break
        key = candidate
    index = keys.index(key)
    if time <= key["t"] or index + 1 == len(keys) or key["hold"]:
        return list(key["s"])
    if time >= keys[index + 1]["t"]:
        return list(key["e"])
    fraction = (time - key["t"]) / (keys[index + 1]["t"] - key["t"])
    result = []
    for i, (start, end) in enumerate(zip(key["s"], key["e"], strict=True)):
        low, high = 0.0, 1.0
        for _ in range(32):
            u = (low + high) / 2
            x = 3 * (1 - u) ** 2 * u * key["ox"][i] + 3 * (1 - u) * u * u * key["ix"][i] + u**3
            if x < fraction:
                low = u
            else:
                high = u
        u = (low + high) / 2
        eased = 3 * (1 - u) ** 2 * u * key["oy"][i] + 3 * (1 - u) * u * u * key["iy"][i] + u**3
        result.append(start + (end - start) * eased)
    return result


def blur_sample_times(
    tracks: list[dict[str, Any]], ip: float, op: float, node: tuple[float, float, float, float]
) -> list[tuple[float, bool]]:
    nip, nop, start, stretch = node
    low, high = max(ip, nip), min(op, nop)
    first, stop = math.ceil(low), math.ceil(high)
    count = max(0, stop - first)
    frames = [first + (count - 1) * i / 1023 for i in range(1024)] if count > 1024 else list(range(first, stop))
    times = {((frame - start) / stretch, False) for frame in frames}
    # Include subframe keys even when the frame budget is exhausted. All tracks
    # are available identically to conversion and binary inspection.
    for track in tracks:
        for i, key in enumerate(track["keys"]):
            time = key["t"]
            if low <= time * stretch + start < high:
                times.add((time, False))
                if i:
                    previous = track["keys"][i - 1]
                    end = previous["s"] if previous["hold"] else previous["e"]
                    if list(end) != list(key["s"]):
                        times.add((time, True))
    return sorted(times)


def sigma_range(
    tracks: list[dict[str, Any]], blur_track: int, scale_track: int, samples: list[tuple[float, bool]]
) -> list[float]:
    blur, scale = tracks[blur_track], tracks[scale_track]
    times = {k["t"] for track in (blur, scale) for k in track["keys"]} | {t for t, _ in samples}
    values = [
        0.3 * evaluate_track(blur, t, left)[0] * abs(evaluate_track(scale, t, left)[0]) / 100
        for t in times
        for left in (False, True)
    ]
    return [min(values), max(values)]


def inspect_spaf(blob: bytes) -> tuple[dict[str, dict[str, int]], dict[str, int], dict[str, Any] | None]:
    require(len(blob) >= 88, "truncated", "$", "SPAF header requires 88 bytes")
    version, kind, total, crc = struct.unpack_from("<4I", blob, 4)
    require(version == 2 and kind == 1, "version", "$", "Unsupported SPAF version or kind")
    require(total == len(blob) and total <= 1_048_576 and total % 4 == 0, "length", "$", "Invalid SPAF length")
    require(zlib.crc32(blob[:16] + b"\0" * 4 + blob[20:]) == crc, "crc", "$", "SPAF CRC mismatch")
    fps, ip, op = struct.unpack_from("<3f", blob, 20)
    require(
        bounded(fps, 1, 240) and bounded(ip, -1e9, 1e9) and bounded(op, -1e9, 1e9) and ip < op,
        "numeric",
        "$",
        "Invalid composition time",
    )
    tables: list[list[tuple[Any, ...]]] = []
    cursor = 88
    for i, (fmt, limit) in enumerate(
        zip(("<6i4f", "<5I6i2I4i", "<3Ii", "<fI6I", "<3I"), (32, 8, 256, 2048, 32), strict=True)
    ):
        offset, count = struct.unpack_from("<2I", blob, 32 + i * 8)
        stride = struct.calcsize(fmt)
        require(count <= limit, "limit", "$", "SPAF table exceeds capacity")
        require(offset == cursor and cursor + count * stride <= total, "offset", "$", "Noncanonical SPAF table")
        tables.append([struct.unpack_from(fmt, blob, cursor + j * stride) for j in range(count)])
        cursor += count * stride
    payload_offset, payload_bytes = struct.unpack_from("<2I", blob, 72)
    require(payload_offset == cursor and payload_bytes == total - cursor, "offset", "$", "Invalid payload span")
    nodes, draws, tracks, keys, slots = tables

    def payload(offset: int, size: int) -> bytes:
        require(
            offset % 4 == 0 and cursor <= offset <= total and 0 <= size <= total - offset,
            "offset",
            "$",
            "Payload reference outside aligned payload",
        )
        return blob[offset : offset + size]

    params: dict[str, dict[str, int]] = {}
    for offset, size, dim in slots:
        require(2 <= size <= 33 and 1 <= dim <= 144, "slot", "$", "Invalid slot size or dimension")
        name_bytes = payload(offset, size)
        require(name_bytes[-1:] == b"\0", "slot", "$", "Slot name needs a terminator")
        name = name_bytes[:-1].decode("ascii", errors="replace")
        require(SID.fullmatch(name) is not None and name not in params, "slot", "$", "Invalid or duplicate slot id")
        params[name] = {"dim": dim}
    evaluated_tracks: list[dict[str, Any]] = []
    values: list[list[tuple[float, ...]]] = []
    key_cursor = 0
    for dim, count, first, slot in tracks:
        require(1 <= dim <= 144 and count > 0, "dimension", "$", "Invalid track dimension or key count")
        require(first == key_cursor and first + count <= len(keys), "reference", "$", "Invalid key span")
        require(-1 <= slot < len(slots), "reference", "$", "Invalid slot reference")
        if slot >= 0:
            require(slots[slot][2] == dim, "dimension", "$", "Slot/track dimensions differ")
        key_cursor += count
        previous = -math.inf
        endpoints = []
        evaluated_keys = []
        for frame, hold, *offsets in keys[first : first + count]:
            require(
                bounded(frame, -1e9, 1e9) and frame > previous and hold in (0, 1),
                "numeric",
                "$",
                "Invalid key time or hold",
            )
            previous = frame
            record: dict[str, Any] = {"t": frame, "hold": hold}
            for i, offset in enumerate(offsets):
                vector = struct.unpack(f"<{dim}f", payload(offset, dim * 4))
                record[VECTORS[i]] = vector
                low, high = (-1024, 1024) if i < 2 else (0, 1)
                require(all(bounded(x, low, high) for x in vector), "numeric", "$", "Invalid key vector")
                if i < 2:
                    endpoints.append(vector)
            evaluated_keys.append(record)
        evaluated_tracks.append({"keys": evaluated_keys})
        values.append(endpoints)
    require(key_cursor == len(keys), "reference", "$", "Unowned key records")

    def role(index: int, dims: tuple[int, ...], low: float, high: float) -> None:
        require(0 <= index < len(tracks), "reference", "$", "Invalid track reference")
        require(tracks[index][0] in dims, "dimension", "$", "Track dimension does not match its role")
        require(
            all(bounded(v, low, high) for vector in values[index] for v in vector),
            "numeric",
            "$",
            "Track values outside role range",
        )

    depths: list[int] = []
    for i, (parent, p, a, s, r, o, nip, nop, start, stretch) in enumerate(nodes):
        require(-1 <= parent < i, "reference", "$", "Parents must precede children")
        depth = 1 if parent < 0 else depths[parent] + 1
        require(depth <= 8, "depth", "$", "Node depth exceeds 8")
        depths.append(depth)
        require(
            bounded(nip, -1e9, 1e9)
            and bounded(nop, -1e9, 1e9)
            and nip < nop
            and bounded(start, -1e6, 1e6)
            and bounded(stretch, struct.unpack("<f", struct.pack("<f", 0.001))[0], 1000),
            "numeric",
            "$",
            "Invalid node time",
        )
        for index in (p, a):
            role(index, (2, 3), -1024, 1024)
        role(s, (2, 3), -200, 200)
        role(r, (1,), -1024, 1024)
        role(o, (1,), 0, 100)
    for (
        node,
        kind,
        vertices,
        closed,
        fill,
        g0,
        g1,
        g2,
        color,
        opacity,
        width,
        paint,
        n,
        start,
        end,
        stops,
        space,
    ) in draws:
        require(node < len(nodes), "reference", "$", "Invalid draw node")
        require(
            kind in (0, 1, 2)
            and closed in (0, 1)
            and fill in (0, 1)
            and (2 <= vertices <= 24 if kind == 2 else vertices == 0),
            "topology",
            "$",
            "Invalid draw topology",
        )
        role(g0, (vertices * 6 if kind == 2 else 2,), -1024, 1024)
        if kind == 2:
            require(g1 == g2 == -1, "reference", "$", "Path has extraneous geometry references")
        else:
            role(g1, (2,), 0, 1024)
            role(g2, (1,), 0, 1024)
        role(color, (4,), 0, 1)
        role(opacity, (1,), 0, 100)
        role(width, (1,), 0, 128)
        require(paint in (0, 1, 2), "topology", "$", "Invalid fill kind")
        if paint == 0:
            require(n == 0 and start == end == stops == space == -1, "reference", "$", "Solid fill has gradient fields")
        else:
            require(fill == 1 and 1 <= n <= 16, "topology", "$", "Invalid gradient fill")
            require(0 <= space < len(nodes), "reference", "$", "Invalid gradient coordinate node")
            role(start, (2,), -1024, 1024)
            role(end, (2,), -1024, 1024)
            role(stops, tuple(range(4 * n, 145, 2)), 0, 1)
            require(
                all(tracks[t][3] == -1 for t in (start, end, stops)), "slot", "$", "Gradient tracks cannot use slots"
            )
    fills = sum(draw[4] for draw in draws)
    blur_track, blur_draws, blur_node = struct.unpack_from("<iHH", blob, 80)
    blur = None
    if blur_track == -1:
        require(blur_draws == blur_node == 0, "blur", "$", "No-blur header fields disagree")
    else:
        role(blur_track, (1,), 0, 1024)
        require(tracks[blur_track][3] == -1, "blur", "$", "Blurriness cannot use a slot")
        require(
            1 <= blur_draws <= len(draws) and blur_node < len(nodes), "blur", "$", "Invalid blur draw count or node"
        )
        color = draws[0][8]
        for i, draw in enumerate(draws):
            node = draw[0]
            while node >= 0 and node != blur_node:
                node = nodes[node][0]
            require(
                (node == blur_node) == (i < blur_draws), "blur", "$", "Blur draws must form the complete first layer"
            )
            if i < blur_draws:
                require(draw[11] == 0 and draw[8] == color, "blur", "$", "Blur draws require one identical solid color")
        blur = {
            "draws": blur_draws,
            "node": blur_node,
            "sigma_px": sigma_range(
                evaluated_tracks,
                blur_track,
                nodes[blur_node][3],
                blur_sample_times(evaluated_tracks, ip, op, nodes[blur_node][6:10]),
            ),
        }
    return params, {"fill": fills, "stroke": len(draws) - fills}, blur


def image_warnings(kind: str, scans: list[int]) -> list[dict[str, str]]:
    result = [
        {
            "code": "no_params",
            "message": "Images have no parameters; replacing a standard vector asset disables its parameters.",
        }
    ]
    if kind == "gif" and any(n > 2 for n in scans):
        result.append(
            {
                "code": "slow_gif",
                "message": "Frame intervals slower than about 30 fps may flicker during high contrast motion.",
            }
        )
    return result


def inspect_pimg(blob: bytes) -> tuple[str, list[dict[str, str]]]:
    require(len(blob) >= 64, "truncated", "$", "PIMG header and entry require 64 bytes")
    version, count, total, crc = struct.unpack_from("<HHII", blob, 4)
    require(version == 2 and count == 1, "version", "$", "Expected PIMG v2 with one image")
    require(total == len(blob) and total % 2 == 0, "length", "$", "Invalid PIMG length")
    require(zlib.crc32(blob[32:]) == crc, "crc", "$", "PIMG CRC mismatch")
    require(
        blob[16:32] == b"\0" * 16 and blob[54:56] == b"\0" * 2 and blob[60:64] == b"\0" * 4,
        "reserved",
        "$",
        "Nonzero reserved bytes",
    )
    name = blob[32:52]
    require(re.fullmatch(rb"[A-Z0-9_]+\x00+", name) is not None, "name", "$", "Invalid PIMG name")
    frames, _reserved, table = struct.unpack_from("<HHI", blob, 52)
    require(1 <= frames <= 64, "limit", "$", "PIMG requires 1..64 frames")
    require(table >= 64 and table % 2 == 0 and table + frames * 12 <= total, "offset", "$", "Invalid frame table span")
    scans = []
    for i in range(frames):
        offset, words, duration = struct.unpack_from("<3I", blob, table + i * 12)
        require(
            offset % 2 == 0 and offset >= table + frames * 12 and words > 0 and offset + words * 2 <= total,
            "offset",
            "$",
            "Invalid RLE span",
        )
        scans.append(duration)
        cursor, end, pixels = offset, offset + words * 2, 0
        while cursor < end:
            control = struct.unpack_from("<H", blob, cursor)[0]
            cursor += 2
            length = (control & 0x7FFF) + 1
            cursor += 2 if control & 0x8000 else length * 2
            pixels += length
            require(cursor <= end and pixels <= 480 * 480, "rle", "$", "RLE exceeds its stream or framebuffer")
        require(pixels == 480 * 480, "rle", "$", "RLE does not fill the framebuffer")
    require(
        scans == [0] if frames == 1 else all(n >= 1 for n in scans),
        "duration",
        "$",
        "Static images need zero refresh counts; animation frames need positive refresh counts",
    )
    kind = "image" if frames == 1 else "gif"
    return kind, image_warnings(kind, scans)


def inspect(blob: bytes) -> dict[str, Any]:
    require(len(blob) <= MAX_FILE, "limit", "$", "Asset exceeds display storage")
    details: dict[str, Any] = {}
    if blob[:4] == b"SPAF":
        params, draws, blur = inspect_spaf(blob)
        if blur is not None:
            details["blur"] = blur
        details["draws"] = draws
        kind = "vector"
        notices: list[dict[str, str]] = []
    elif blob[:4] == b"PIMG":
        kind, notices = inspect_pimg(blob)
        params = {}
    else:
        raise AssetError("magic", "$", "Expected SPAF or PIMG")
    return {
        "ok": True,
        "kind": kind,
        "bytes": len(blob),
        "crc32": f"{zlib.crc32(blob):08x}",
        "params": params,
        "warnings": notices,
        **details,
    }


def rle_pack(pixels: list[int]) -> bytes:
    words: list[int] = []
    i = 0
    while i < len(pixels):
        end = i + 1
        while end < len(pixels) and end - i < 32768 and pixels[end] == pixels[i]:
            end += 1
        if end - i >= 3:
            words.extend((0x8000 | (end - i - 1), pixels[i]))
            i = end
        else:
            start = i
            i = end
            while i < len(pixels) and i - start < 32768:
                if i + 2 < len(pixels) and pixels[i] == pixels[i + 1] == pixels[i + 2]:
                    break
                i += 1
            words.append(i - start - 1)
            words.extend(pixels[start:i])
    packed = array("H", words)
    if sys.byteorder != "little":
        packed.byteswap()
    return packed.tobytes()


def convert_image(source: Path) -> bytes:
    try:
        from PIL import Image, ImageOps
    except ImportError as exc:
        raise AssetError("dependency", str(source), "Install the system python3-pil package") from exc
    formats = {".gif": "GIF", ".png": "PNG", ".jpg": "JPEG", ".jpeg": "JPEG"}
    try:
        with warnings.catch_warnings():
            warnings.simplefilter("error", Image.DecompressionBombWarning)
            with Image.open(source) as image:
                require(
                    image.format == formats[source.suffix.lower()],
                    "type",
                    str(source),
                    "Extension and image content differ",
                )
                gif = image.format == "GIF"
                frames = getattr(image, "n_frames", 1) if gif else 1
                require(1 <= frames <= 64, "limit", str(source), "At most 64 GIF frames are supported")
                streams, durations = [], []
                for i in range(frames):
                    image.seek(i)
                    duration = image.info.get("duration", 0) or 10
                    durations.append(max(1, round(duration / 16.24)) if frames > 1 else 0)
                    frame = ImageOps.exif_transpose(image).convert("RGBA")
                    frame = ImageOps.contain(frame, (480, 480), Image.Resampling.LANCZOS)
                    canvas = Image.new("RGBA", (480, 480), (0, 0, 0, 255))
                    canvas.alpha_composite(frame, ((480 - frame.width) // 2, (480 - frame.height) // 2))
                    rgb = canvas.convert("RGB").tobytes()
                    pixels = []
                    for y in range(480):
                        for x in range(480):
                            # Pixel centers define the panel's radius-240 visible circle.
                            if (2 * x - 479) ** 2 + (2 * y - 479) ** 2 > 480**2:
                                pixels.append(0)
                            else:
                                p = (y * 480 + x) * 3
                                r, g, b = rgb[p : p + 3]
                                pixels.append((r >> 3) << 11 | (g >> 2) << 5 | b >> 3)
                    streams.append(rle_pack(pixels))
    except (Image.DecompressionBombError, Image.DecompressionBombWarning, EOFError, SyntaxError) as exc:
        raise AssetError("image", str(source), str(exc)) from exc
    data_offset = 64 + frames * 12
    body = bytearray(struct.pack("<20sHHII", b"IMAGE", frames, 0, 64, 0))
    for stream, duration in zip(streams, durations, strict=True):
        body.extend(struct.pack("<3I", data_offset, len(stream) // 2, duration))
        data_offset += len(stream)
    body.extend(b"".join(streams))
    return struct.pack("<4sHHII16x", b"PIMG", 2, 1, 32 + len(body), zlib.crc32(body)) + body


def load_lottie(stream: BinaryIO) -> Any:
    """Bound source bytes and JSON structure before allocating the decoded tree."""
    raw = bytearray()
    tokens = depth = 0
    quoted = escaped = scalar = False
    while chunk := stream.read(min(65536, MAX_SOURCE_BYTES + 1 - len(raw))):
        raw.extend(chunk)
        require(len(raw) <= MAX_SOURCE_BYTES, "limit", "$", "Lottie source exceeds byte limit")
        for byte in chunk:
            if quoted:
                if escaped:
                    escaped = False
                elif byte == 92:
                    escaped = True
                elif byte == 34:
                    quoted = False
                continue
            if byte in b" \t\r\n,:]}":
                scalar = False
                if byte in b"]}":
                    depth -= 1
                continue
            if byte == 34:
                quoted = True
            elif byte in b"[{":
                depth += 1
                scalar = False
                require(depth <= MAX_JSON_DEPTH, "limit", "$", "Lottie source exceeds nesting limit")
            elif scalar:
                continue
            else:
                scalar = True
            tokens += 1
            require(tokens <= MAX_JSON_TOKENS, "limit", "$", "Lottie source exceeds token limit")
    return json.loads(raw)


class Lottie:
    def __init__(self, doc: dict[str, Any]) -> None:
        self.doc = doc
        self.tracks: list[dict[str, Any]] = []
        self.nodes: list[dict[str, Any]] = []
        self.draws: list[dict[str, Any]] = []
        self.paint_draws: dict[str, list[dict[str, Any]]] = {}
        self.fills: dict[str, list[tuple[dict[str, Any], str, int]]] = {}
        self.errors: list[dict[str, str]] = []
        self.slot_dims: dict[str, int] = {}
        self.key_count = 0
        self.blur_layer: dict[str, Any] | None = None
        self.blur_track = -1
        self.blur_draws = 0

    def error(self, layer: str, feature: str, path: str, code: str = "unsupported") -> None:
        self.errors.append({"code": code, "path": path, "message": f"{layer}: {feature}"})

    def check_errors(self) -> None:
        if self.errors:
            exc = AssetError("unsupported", "$", "Unsupported Lottie")
            exc.errors = self.errors
            raise exc

    def resolve(self, prop: dict[str, Any]) -> dict[str, Any]:
        sid = prop.get("sid")
        default = self.doc.get("slots", {}).get(sid, {}).get("p", {}) if sid else {}
        return {**prop, **default}

    def scan(self, obj: Any, path: str, layer: str) -> None:
        if isinstance(obj, list):
            for i, item in enumerate(obj):
                self.scan(item, f"{path}[{i}]", layer)
            return
        if not isinstance(obj, dict):
            return
        if obj.get("a") and isinstance(obj.get("k"), list):
            require(len(obj["k"]) <= MAX_KEYS, "limit", path, "Too many property keys")
        ty = obj.get("ty")
        if isinstance(ty, str) and ty not in {"gr", "el", "rc", "sh", "fl", "gf", "st", "tr"}:
            self.error(
                layer,
                {"tm": "trim path", "gf": "gradient fill", "gs": "gradient stroke", "rp": "repeater", "sr": "star"}.get(
                    ty, f"shape {ty}"
                ),
                path + ".ty",
            )
        if isinstance(obj.get("x"), str):
            self.error(layer, "expression", path + ".x")
        for key in ("masksProperties", "tt", "td", "tm"):
            if obj.get(key):
                self.error(layer, key, path + "." + key)
        if "parent" in obj:
            self.error(layer, "parent layer", path + ".parent")
        if ty == "tr" or path.endswith(".ks"):
            for key in ("rx", "ry", "rz", "or"):
                if key in obj:
                    self.error(layer, "3D transform " + key, path + "." + key)
        for key in ("ddd", "bm", "ao"):
            if obj.get(key, 0):
                self.error(layer, key, path + "." + key)
        if isinstance(obj.get("d"), list) and obj["d"]:
            self.error(layer, "stroke dashes", path + ".d")
        if obj.get("hasMask") and not obj.get("masksProperties"):
            self.error(layer, "mask", path + ".hasMask")
        if obj.get("s") is True:
            self.error(layer, "separated position", path + ".s")
        for key in ("to", "ti"):
            if key in obj:
                self.error(layer, "spatial tangents", path + "." + key)
        for key in ("sk", "sa"):
            if key in obj and (not isinstance(obj[key], dict) or obj[key].get("a") or obj[key].get("k", 0)):
                self.error(layer, "skew", path + "." + key)
        if "sid" in obj and (not isinstance(obj["sid"], str) or SID.fullmatch(obj["sid"]) is None):
            self.error(layer, "slot id must match [a-z0-9_]{1,32}", path + ".sid", "slot")
        if ty in ("fl", "gf") and (type(obj.get("r", 1)) is not int or obj.get("r", 1) not in (1, 2)):
            self.error(layer, "fill rule must be nonzero or evenodd", path + ".r")
        if ty == "gf":
            self.scan_gradient(obj, path, layer)
        if ty == "st":
            for key in ("lc", "lj"):
                if obj.get(key, 1) != 2:
                    self.error(layer, "only explicit round cap/join is supported", path + "." + key)
        if ty in ("rc", "el") and obj.get("d", 1) != 1:
            self.error(layer, "reverse primitive direction", path + ".d")
        for key in ("shapes", "it"):
            if key in obj:
                items = obj[key]
                require(
                    isinstance(items, list) and all(isinstance(x, dict) for x in items),
                    "input",
                    path + "." + key,
                    "Expected a shape list",
                )
                seen_paint = False
                transforms = 0
                for i, item in enumerate(items):
                    item_path = f"{path}.{key}[{i}]"
                    item_ty = item.get("ty")
                    if item_ty in ("fl", "gf", "st"):
                        seen_paint = True
                    elif item_ty in ("gr", "el", "rc", "sh") and seen_paint:
                        self.error(layer, "interleaved geometry/style ordering", item_path)
                    if item_ty == "tr":
                        transforms += 1
                if transforms > 1:
                    self.error(layer, "multiple group transforms", path + "." + key)
        for key, value in obj.items():
            if key == "ef":
                if value and re.fullmatch(r"\$\.layers\[\d+\]", path) is None:
                    self.error(layer, "Put Gaussian Blur on a layer; remove nested effects", path + ".ef")
            else:
                self.scan(value, path + "." + key, layer)

    def scan_gradient(self, paint: dict[str, Any], path: str, layer: str) -> None:
        if type(paint.get("t")) is not int or paint["t"] not in (1, 2):
            self.error(layer, "gradient type must be linear or radial", path + ".t")
        if "h" in paint:
            h = paint["h"]
            if not isinstance(h, dict) or h.get("a", 0) != 0 or not bounded(h.get("k"), 0, 0) or "sid" in h:
                self.error(layer, "gradient highlight must be static zero", path + ".h")
        for key in ("g", "s", "e"):
            prop = paint.get(key)
            if not isinstance(prop, dict):
                self.error(layer, "gradient property required", path + "." + key, "input")
            elif "sid" in prop:
                self.error(layer, "gradient slots are unsupported", path + "." + key + ".sid", "slot")
        g = paint.get("g")
        if not isinstance(g, dict):
            return
        n, prop = g.get("p"), g.get("k")
        if isinstance(prop, dict) and "sid" in prop:
            self.error(layer, "gradient slots are unsupported", path + ".g.k.sid", "slot")
        if type(n) is not int or not 1 <= n <= 16:
            self.error(layer, "gradient requires 1..16 color stops", path + ".g.p", "numeric")
            return
        if not isinstance(prop, dict):
            self.error(layer, "gradient stop property required", path + ".g.k", "input")
            return
        raw = prop.get("k")
        vectors = []
        if prop.get("a"):
            if isinstance(raw, list):
                vectors = [key[field] for key in raw if isinstance(key, dict) for field in ("s", "e") if field in key]
        else:
            vectors = [raw]
        dim = len(vectors[0]) if vectors and isinstance(vectors[0], list) else 0
        if not vectors or dim < 4 * n or (dim - 4 * n) % 2:
            self.error(layer, "invalid gradient stop dimension", path + ".g.k", "dimension")
        for vector in vectors:
            if not isinstance(vector, list) or len(vector) != dim or any(not bounded(v, 0, 1) for v in vector):
                self.error(
                    layer, "gradient stops require equal dimensions and values in 0..1", path + ".g.k", "numeric"
                )
                continue
            if any(a > b for positions in (vector[: 4 * n : 4], vector[4 * n :: 2]) for a, b in pairwise(positions)):
                self.error(layer, "gradient stop positions must be nondecreasing", path + ".g.k", "numeric")

    def gradient_tracks(self, paint: dict[str, Any], path: str, layer: str, node: int) -> list[int]:
        coordinates = []
        for field in ("s", "e"):
            index = self.prop(paint[field], None, path + "." + field, layer, (2, 3), -1024, 1024)
            track = self.tracks[index]
            track["dim"] = 2
            for key in track["keys"]:
                for vector in VECTORS:
                    key[vector] = key[vector][:2]
            coordinates.append(index)
        n = paint["g"]["p"]
        stops = self.prop(paint["g"]["k"], None, path + ".g.k", layer, tuple(range(4 * n, 145, 2)), 0, 1)
        return [paint["t"], n, *coordinates, stops, node]

    def prop(
        self,
        prop: Any,
        default: Any,
        path: str,
        layer: str,
        dims: tuple[int, ...],
        low: float,
        high: float,
        topology: tuple[int, bool] | None = None,
    ) -> int:
        require(len(self.tracks) < MAX_TRACKS, "limit", path, "Too many tracks")
        p = self.resolve(prop if prop is not None else {"k": default})
        sid = prop.get("sid", "") if prop is not None else ""
        raw_keys = p["k"] if p.get("a") else [{"t": 0, "s": p["k"]}]
        require(isinstance(raw_keys, list) and len(raw_keys) > 0, "input", path, "Expected nonempty key list")

        require(self.key_count + len(raw_keys) <= MAX_KEYS, "limit", path, "Too many keys")
        self.key_count += len(raw_keys)

        def flatten(value: Any) -> list[Any]:
            if topology is not None:
                shape = value[0] if isinstance(value, list) and len(value) == 1 else value
                vertices, closed = topology
                require(isinstance(shape, dict) and shape.get("c") is closed, "topology", path, "Changing path closure")
                vector: list[Any] = []
                for key in ("v", "i", "o"):
                    points = shape[key]
                    require(
                        isinstance(points, list)
                        and len(points) == vertices
                        and all(isinstance(x, list) and len(x) == 2 for x in points),
                        "topology",
                        path,
                        "Changing path vertex/tangent count",
                    )
                    vector.extend(n for xy in points for n in xy)
                return vector
            return value if isinstance(value, list) else [value]

        keys: list[dict[str, Any]] = []
        previous = -math.inf
        for i, key in enumerate(raw_keys):
            value = key.get("s", raw_keys[i - 1].get("e", raw_keys[i - 1].get("s"))) if i else key["s"]
            start = flatten(value)
            end = flatten(key.get("e", raw_keys[i + 1].get("s", value))) if i + 1 < len(raw_keys) else start
            dim = len(start)
            require(max(dim, len(end)) <= MAX_COMPONENTS, "limit", path, "Too many property components")
            if dim not in dims or len(end) != dim or any(not bounded(x, low, high) for x in [*start, *end]):
                self.error(layer, f"property requires dimension {dims} and values {low}..{high}", path, "numeric")
            t = key["t"]
            valid_time = bounded(t, -1e9, 1e9)
            frame = struct.unpack("<f", struct.pack("<f", t))[0] if valid_time else 0
            if not valid_time or frame <= previous or key.get("h", 0) not in (0, 1):
                self.error(layer, "finite increasing float32 key times and boolean hold required", path, "numeric")
            previous = frame
            record = {"t": t, "hold": key.get("h", 0), "s": start, "e": end}
            for which, axis, fallback in (("o", "x", 0), ("o", "y", 0), ("i", "x", 1), ("i", "y", 1)):
                handle = key.get(which, {}).get(axis, fallback)
                handle = handle if isinstance(handle, list) else [handle]
                require(len(handle) <= MAX_COMPONENTS, "limit", path, "Too many easing components")
                handle = handle * dim if len(handle) == 1 else handle
                if len(handle) != dim or any(not bounded(v, 0, 1) for v in handle):
                    self.error(layer, "easing controls require dimension-matched values in 0..1", path, "numeric")
                record[which + axis] = handle
            keys.append(record)
        dim = len(keys[0]["s"])
        if any(len(k["s"]) != dim for k in keys):
            self.error(layer, "changing property dimension", path, "topology")
        if sid:
            if sid in self.slot_dims and self.slot_dims[sid] != dim:
                self.error(layer, "one slot id cannot have different dimensions", path, "slot")
            self.slot_dims[sid] = dim
        self.tracks.append({"slot": sid, "dim": dim, "keys": keys})
        return len(self.tracks) - 1

    def node(
        self, tr: dict[str, Any], parent: int, ip: float, op: float, start: float, stretch: float, path: str, layer: str
    ) -> int:
        ids = []
        for name, default, dims, low, high in (
            ("p", [0, 0], (2, 3), -1024, 1024),
            ("a", [0, 0], (2, 3), -1024, 1024),
            ("s", [100, 100], (2, 3), -200, 200),
            ("r", 0, (1,), -1024, 1024),
            ("o", 100, (1,), 0, 100),
        ):
            ids.append(self.prop(tr.get(name), default, path + "." + name, layer, dims, low, high))
        if not (
            bounded(ip, -1e9, 1e9)
            and bounded(op, -1e9, 1e9)
            and ip < op
            and bounded(start, -1e6, 1e6)
            and bounded(stretch, 0.001, 1000)
        ):
            self.error(layer, "node time outside supported range", path, "numeric")
        self.nodes.append({"parent": parent, "tracks": ids, "ip": ip, "op": op, "start": start, "stretch": stretch})
        return len(self.nodes) - 1

    def group(
        self,
        items: list[dict[str, Any]],
        parent: int,
        name: str,
        path: str,
        inherited: tuple[tuple[dict[str, Any], str, int], ...] = (),
        depth: int = 2,
    ) -> None:
        if depth > 8:
            self.error(name, "node depth exceeds 8", path, "depth")
            return
        transforms = [(x, f"{path}[{i}]") for i, x in enumerate(items) if x["ty"] == "tr"]
        tr, tr_path = transforms[0] if transforms else ({}, path)
        at = self.node(tr, parent, -1e9, 1e9, 0, 1, tr_path, name)
        paints = [(x, f"{path}[{i}]") for i, x in enumerate(items) if x["ty"] in ("fl", "gf", "st") and not x.get("hd")]
        # lottie-web registers styles during reverse depth-first traversal, then
        # draws every shape belonging to one style before advancing to the next.
        for _, paint_path in reversed(paints):
            self.paint_draws[paint_path] = []
        effective = (*inherited, *((paint, p, at) for paint, p in reversed(paints)))
        for i in reversed(range(len(items))):
            item, item_path = items[i], f"{path}[{i}]"
            ty = item["ty"]
            if item.get("hd"):
                continue
            if ty == "gr":
                self.group(
                    item["it"], at, name + "/" + item.get("nm", "group"), item_path + ".it", effective, depth + 1
                )
            elif ty in ("el", "rc", "sh"):
                closed, vertices = True, 0
                if ty == "sh":
                    p = self.resolve(item["ks"])
                    shape = p["k"][0]["s"][0] if p.get("a") else p["k"]
                    closed, vertices = shape["c"], len(shape["v"])
                    if type(closed) is not bool or not 2 <= vertices <= 24:
                        self.error(
                            name, "path requires 2..24 vertices and boolean closure", item_path + ".ks", "topology"
                        )
                        continue
                    try:
                        geo = [
                            self.prop(
                                item["ks"],
                                None,
                                item_path + ".ks",
                                name,
                                (vertices * 6,),
                                -1024,
                                1024,
                                (vertices, closed),
                            ),
                            -1,
                            -1,
                        ]
                    except AssetError as exc:
                        if any(error["code"] == "limit" for error in exc.errors):
                            raise
                        for error in exc.errors:
                            self.error(name, error["message"], error["path"], error["code"])
                        continue
                else:
                    geo = [
                        self.prop(item.get(k), default, item_path + "." + k, name, dims, low, 1024)
                        for k, default, dims, low in (
                            ("p", [0, 0], (2,), -1024),
                            ("s", [0, 0], (2,), 0),
                            ("r", 0, (1,), 0),
                        )
                    ]
                for paint, paint_path, paint_node in effective:
                    fill = paint["ty"] in ("fl", "gf")
                    gradient = (
                        self.gradient_tracks(paint, paint_path, name, paint_node)
                        if paint["ty"] == "gf"
                        else [0, 0, -1, -1, -1, -1]
                    )
                    color = self.prop(
                        paint.get("c") if paint["ty"] != "gf" else None,
                        [1, 1, 1, 1],
                        paint_path + ".c",
                        name,
                        (4,),
                        0,
                        1,
                    )
                    opacity = self.prop(paint.get("o"), 100, paint_path + ".o", name, (1,), 0, 100)
                    width = self.prop(paint.get("w"), 0, paint_path + ".w", name, (1,), 0, 128)
                    draws = self.paint_draws[paint_path]
                    draws.append(
                        {
                            "node": at,
                            "kind": {"el": 0, "rc": 1, "sh": 2}[ty],
                            "geo": geo,
                            "vertices": vertices,
                            "closed": closed,
                            "fill": fill,
                            "color": color,
                            "color_path": paint_path + ".c",
                            "opacity": opacity,
                            "width": width,
                            "gradient": gradient,
                        }
                    )
                    if fill:
                        self.fills.setdefault(paint_path, []).append((draws[-1], item_path, paint.get("r", 1)))

    def shared_fills(self) -> None:
        def vectors(track: int, path: str) -> list[list[float]]:
            prop = self.tracks[track]
            require(not prop["slot"], "unsupported", path, "Shared fill geometry cannot use slots")
            return [
                list(struct.unpack(f"<{prop['dim']}f", struct.pack(f"<{prop['dim']}f", *key[which])))
                for key in prop["keys"]
                for which in ("s", "e")
            ]

        def bounds(draw: dict[str, Any], path: str) -> tuple[float, float, float, float]:
            if draw["kind"] == 2:
                values = vectors(draw["geo"][0], path)
                count = draw["vertices"]
                # A Bezier lies within its control hull. Component easing stays in 0..1,
                # so independent endpoint ranges also bound every interpolated control.
                ranges = [(min(v[i] for v in values), max(v[i] for v in values)) for i in range(count * 6)]
                axes = []
                for axis in (0, 1):
                    lows, highs = [], []
                    for i in range(axis, count * 2, 2):
                        low, high = ranges[i]
                        lows.append(low)
                        highs.append(high)
                        for offset in (count * 2, count * 4):
                            lows.append(low + ranges[i + offset][0])
                            highs.append(high + ranges[i + offset][1])
                    axes.append((min(lows), max(highs)))
                return axes[0][0], axes[1][0], axes[0][1], axes[1][1]
            positions, sizes = vectors(draw["geo"][0], path), vectors(draw["geo"][1], path)
            return (
                min(v[0] for v in positions) - max(v[0] for v in sizes) / 2,
                min(v[1] for v in positions) - max(v[1] for v in sizes) / 2,
                max(v[0] for v in positions) + max(v[0] for v in sizes) / 2,
                max(v[1] for v in positions) + max(v[1] for v in sizes) / 2,
            )

        def polygon(draw: dict[str, Any], path: str) -> list[tuple[float, float]]:
            tracks = [self.tracks[t] for t in draw["geo"] if t >= 0]
            require(
                all(len(t["keys"]) == 1 and not t["slot"] for t in tracks),
                "unsupported",
                path,
                "Overlapping shared fills require static geometry",
            )
            values = [vectors(t, path)[0] for t in draw["geo"] if t >= 0]
            if draw["kind"] == 1 and values[2] == [0]:
                (x, y), (w, h) = values[:2]
                return [(x - w / 2, y - h / 2), (x + w / 2, y - h / 2), (x + w / 2, y + h / 2), (x - w / 2, y + h / 2)]
            count = draw["vertices"]
            require(
                draw["kind"] == 2 and draw["closed"] and count >= 3 and not any(values[0][count * 2 :]),
                "unsupported",
                path,
                "Overlapping shared fills require closed straight contours",
            )
            return list(zip(values[0][: count * 2 : 2], values[0][1 : count * 2 : 2], strict=True))

        def cross(a: tuple[float, float], b: tuple[float, float], c: tuple[float, float]) -> float:
            return (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])

        def intersects(a: Any, b: Any, c: Any, d: Any) -> bool:
            return (
                max(min(a[0], b[0]), min(c[0], d[0])) <= min(max(a[0], b[0]), max(c[0], d[0]))
                and max(min(a[1], b[1]), min(c[1], d[1])) <= min(max(a[1], b[1]), max(c[1], d[1]))
                and cross(a, b, c) * cross(a, b, d) <= 0
                and cross(c, d, a) * cross(c, d, b) <= 0
            )

        def contains(points: list[tuple[float, float]], point: tuple[float, float]) -> bool:
            x, y = point
            return (
                sum(
                    (a[1] > y) != (b[1] > y) and x < a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1])
                    for a, b in zip(points, points[1:] + points[:1], strict=True)
                )
                % 2
                == 1
            )

        for entries in self.fills.values():
            if len(entries) < 2:
                continue
            current_path = entries[0][1]
            require(
                len({draw["node"] for draw, _, _ in entries}) == 1,
                "unsupported",
                current_path,
                "Shared fills across different group transforms cannot be proven disjoint",
            )
            boxes = [bounds(draw, path) for draw, path, _ in entries]
            if all(
                a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1]
                for i, a in enumerate(boxes)
                for b in boxes[i + 1 :]
            ):
                continue
            members = {id(draw) for draw, _, _ in entries}
            positions = [i for i, draw in enumerate(self.draws) if id(draw) in members]
            require(
                positions[-1] - positions[0] + 1 == len(entries),
                "unsupported",
                current_path,
                "Overlapping shared fills cannot be merged across other paints",
            )
            polygons = []
            for draw, current_path, _ in entries:
                polygons.append(polygon(draw, current_path))
            edges = [list(zip(p, p[1:] + p[:1], strict=True)) for p in polygons]
            signs = []
            for i, edge in enumerate(edges):
                current_path = entries[i][1]
                area = sum(a[0] * b[1] - a[1] * b[0] for a, b in edge)
                simple = area != 0 and all(a != b for a, b in edge)
                for j, (a, b) in enumerate(edge):
                    c = edge[(j + 1) % len(edge)][1]
                    if cross(a, b, c) == 0 and (b[0] - a[0]) * (c[0] - b[0]) + (b[1] - a[1]) * (c[1] - b[1]) < 0:
                        simple = False
                    for k in range(j + 1, len(edge)):
                        if k != j + 1 and (j, k) != (0, len(edge) - 1):
                            simple &= not intersects(a, b, *edge[k])
                require(simple, "unsupported", current_path, "Shared fill contour must be simple and nondegenerate")
                for other in edges[:i]:
                    require(
                        not any(intersects(a, b, c, d) for a, b in edge for c, d in other),
                        "unsupported",
                        current_path,
                        "Shared fill contours intersect or touch",
                    )
                signs.append(1 if area > 0 else -1)
            kept = []
            for i, points in enumerate(polygons):
                winding = sum(signs[j] for j, p in enumerate(polygons) if j != i and contains(p, points[0]))
                if entries[i][2] == 2 or (winding == 0) != (winding + signs[i] == 0):
                    kept.append(points)
            anchor = kept[0][0]
            merged = [anchor]
            for points in kept[1:]:
                merged.extend([*points, points[0], anchor])
            merged.extend(kept[0][1:])
            # Straight segments consume no recursive curve subdivisions; 24 vertices
            # also keep the closed contour below the firmware's 128-segment budget.
            require(len(merged) <= 24, "limit", current_path, "Shared fill exceeds the 24-vertex path budget")
            shape = {
                "v": [list(p) for p in merged],
                "i": [[0, 0]] * len(merged),
                "o": [[0, 0]] * len(merged),
                "c": True,
            }
            track = self.prop(
                {"k": shape}, None, current_path, "shared fill", (len(merged) * 6,), -1024, 1024, (len(merged), True)
            )
            first = entries[0][0]
            first.update(kind=2, vertices=len(merged), closed=True, geo=[track, -1, -1])
            discarded = {id(draw) for draw, _, _ in entries[1:]}
            self.draws = [draw for draw in self.draws if id(draw) not in discarded]

    def scan_blur(self, layer: dict[str, Any], path: str, index: int, layers: list[dict[str, Any]]) -> None:
        effects = layer.get("ef")
        if not effects or layer.get("hd"):
            return
        name = layer.get("nm", str(index))

        def reject(code: str, suffix: str, message: str) -> None:
            self.error(name, message, path + suffix, code)

        if (
            not isinstance(effects, list)
            or len(effects) != 1
            or not isinstance(effects[0], dict)
            or effects[0].get("ty") != 29
        ):
            reject("blur_effect", ".ef", "Use exactly one Gaussian Blur effect (ty 29); delete other effects")
            return
        if self.blur_layer is not None:
            reject("blur_layers", ".ef", "Keep Gaussian Blur on only one layer")
            # Point at both layers, making the conflict actionable from either one.
            previous = self.blur_layer
            self.error(
                previous["name"], "Keep Gaussian Blur on only one layer", previous["path"] + ".ef", "blur_layers"
            )
        else:
            self.blur_layer = {"index": index, "path": path, "name": name}
        if any(not other.get("hd") for other in layers[index + 1 :]):
            reject("blur_order", ".ef", "Move the blurred layer below every visible layer")
        effect = effects[0]
        if effect.get("en") != 1:
            reject(
                "blur_disabled", ".ef[0].en", "lottie-web still previews disabled blur: delete the effect or enable it"
            )
        controls = effect.get("ef")
        if (
            not isinstance(controls, list)
            or len(controls) != 3
            or any(not isinstance(c, dict) or not isinstance(c.get("v"), dict) for c in controls)
        ):
            reject(
                "blur_effect", ".ef", "Export Gaussian Blur with Blurriness, Dimensions and Repeat Edge Pixels controls"
            )
            return
        for i, value, code, message in (
            (1, 1, "blur_dimensions", "Set Dimensions to Both (1)"),
            (2, 0, "blur_repeat", "Turn Repeat Edge Pixels off (0)"),
        ):
            prop = controls[i]["v"]
            if prop.get("a", 0) != 0 or "sid" in prop or prop.get("k") not in (value, [value]):
                reject(code, f".ef[0].ef[{i}].v", message)
        if "sid" in controls[0]["v"]:
            reject("blur_slot", ".ef[0].ef[0].v.sid", "Remove the slot from Blurriness; animate its keys instead")
        for i, control in enumerate(controls):
            self.scan(control["v"], f"{path}.ef[0].ef[{i}].v", name)

        colors: list[dict[str, Any]] = []

        def shapes(items: list[dict[str, Any]], shape_path: str) -> None:
            for i, item in enumerate(items):
                at = f"{shape_path}[{i}]"
                if item.get("hd"):
                    continue
                ty = item.get("ty")
                if ty == "gr":
                    shapes(item.get("it", []), at + ".it")
                elif ty in ("gf", "gs"):
                    self.error(
                        name,
                        "Use one solid color for all blurred fills and strokes; remove gradients",
                        at,
                        "blur_color",
                    )
                elif ty in ("fl", "st"):
                    prop = self.resolve(item.get("c", {"k": [1, 1, 1, 1]}))
                    color = {"k": prop.get("k"), "a": bool(prop.get("a")), "sid": prop.get("sid", "")}
                    if colors and color != colors[0]:
                        self.error(
                            name,
                            "Use the same color property or constant for every blurred paint, including unused paints",
                            at + ".c",
                            "blur_color",
                        )
                    colors.append(color)
                elif ty == "tr":
                    opacity = self.resolve(item.get("o", {"k": 100}))
                    if opacity.get("a", 0) != 0 or opacity.get("k") not in (100, [100]) or "sid" in opacity:
                        self.error(
                            name,
                            "Set group opacity to constant 100; animate opacity on the layer",
                            at + ".o",
                            "blur_opacity",
                        )

        shapes(layer.get("shapes", []), path + ".shapes")

    def validate_blur(self) -> None:
        blur = self.blur_layer
        if blur is None:
            return
        node, track = blur["node"], self.blur_track
        name, path = blur["name"], blur["path"]
        scale_id = self.nodes[node]["tracks"][2]
        scale = self.tracks[scale_id]
        uniform = all(k[v][0] == k[v][1] for k in scale["keys"] for v in VECTORS)
        if not uniform:
            self.error(
                name,
                "Use uniform x/y layer scale with identical easing",
                path + ".ks.s",
                "blur_scale",
            )
            self.check_errors()
        selected = [d for d in self.draws if self.descendant(d["node"], node)]
        self.blur_draws = len(selected)
        if not selected or self.draws[: len(selected)] != selected:
            self.error(
                name,
                "Keep all blurred draws first; separate shared paints from other layers",
                path + ".ef",
                "blur_order",
            )
        # The binary color field is a track id. Intern only the blurred colors so
        # equal properties satisfy the boundary without changing no-blur output.
        if selected:
            color = min(selected, key=lambda d: d["color_path"])["color"]
            for draw in selected:
                if draw["gradient"][0] or self.tracks[draw["color"]] != self.tracks[color]:
                    self.error(
                        name,
                        "Use one identical solid color property for the blurred layer",
                        draw["color_path"],
                        "blur_color",
                    )
                draw["color"] = color
        n = self.nodes[node]
        samples = blur_sample_times(
            self.tracks, self.doc["ip"], self.doc["op"], (n["ip"], n["op"], n["start"], n["stretch"])
        )
        sigma = sigma_range(self.tracks, track, scale_id, samples)
        if not all(bounded(s, 8, 64) for s in sigma):
            self.error(
                name,
                "Keep screen sigma in 8..64 px (0.3 × Blurriness × scale/100); fade with layer opacity",
                path + ".ef[0].ef[0].v",
                "blur_sigma",
            )
        self.check_errors()
        for time, left in samples:
            s = abs(evaluate_track(scale, time, left)[0]) / 100
            sigma_px = 0.3 * evaluate_track(self.tracks[track], time, left)[0] * s
            boxes = [self.geometry_bounds(d, time, node, left) for d in selected]
            width = max(b[2] for b in boxes) - min(b[0] for b in boxes)
            height = max(b[3] for b in boxes) - min(b[1] for b in boxes)
            strokes = [self.stroke_extent(d, time, node, left) for d in selected if not d["fill"]]
            half_stroke = [max((extent[axis] for extent in strokes), default=0) * s for axis in (0, 1)]
            if any(half_stroke[axis] + 3 * sigma_px > size * s + 1e-6 for axis, size in enumerate((width, height))):
                self.error(
                    name,
                    "Enlarge the geometry or reduce the stroke: lottie-web's SVG preview clips the glow where half the transformed stroke width plus 3 sigma exceeds either geometry bbox side (bbox excludes stroke)",
                    path + ".shapes",
                    "blur_bounds",
                )
                break

    def descendant(self, node: int, ancestor: int) -> bool:
        while node >= 0:
            if node == ancestor:
                return True
            node = self.nodes[node]["parent"]
        return False

    def stroke_extent(self, draw: dict[str, Any], time: float, layer: int, left: bool) -> tuple[float, float]:
        # Transform a stroke-radius disk through the group chain. Its affine
        # support on each layer axis is the norm of that matrix row.
        u, v = (1.0, 0.0), (0.0, 1.0)
        node = draw["node"]
        while node != layer:
            tracks = self.nodes[node]["tracks"]
            sx, sy = evaluate_track(self.tracks[tracks[2]], time, left)[:2]
            angle = math.radians(evaluate_track(self.tracks[tracks[3]], time, left)[0])
            c, sn = math.cos(angle), math.sin(angle)
            u, v = [(c * x * sx / 100 - sn * y * sy / 100, sn * x * sx / 100 + c * y * sy / 100) for x, y in (u, v)]
            node = self.nodes[node]["parent"]
        radius = evaluate_track(self.tracks[draw["width"]], time, left)[0] / 2
        return radius * math.hypot(u[0], v[0]), radius * math.hypot(u[1], v[1])

    def geometry_bounds(
        self, draw: dict[str, Any], time: float, layer: int, left: bool = False
    ) -> tuple[float, float, float, float]:
        # Evaluate group transforms in the layer's local coordinates: SVG's
        # objectBoundingBox filter precedes the layer's rotation and scale.
        chain = []
        node = draw["node"]
        while node != layer:
            chain.append(node)
            node = self.nodes[node]["parent"]

        transforms = []
        for at in chain:
            p, a, s, r = [evaluate_track(self.tracks[t], time, left) for t in self.nodes[at]["tracks"][:4]]
            angle = math.radians(r[0])
            transforms.append((p, a, s, math.cos(angle), math.sin(angle)))

        def point(x: float, y: float) -> tuple[float, float]:
            for p, a, s, c, sn in transforms:
                x, y = (x - a[0]) * s[0] / 100, (y - a[1]) * s[1] / 100
                x, y = c * x - sn * y + p[0], sn * x + c * y + p[1]
            return x, y

        values = [evaluate_track(self.tracks[t], time, left) for t in draw["geo"] if t >= 0]
        points: list[tuple[float, float]] = []
        if draw["kind"] == 2:
            path_values = values[0]
            count = draw["vertices"]
            vertices = [point(*path_values[i : i + 2]) for i in range(0, count * 2, 2)]
            points.extend(vertices)
            for i in range(count if draw["closed"] else count - 1):
                j = (i + 1) % count
                p0, p3 = vertices[i], vertices[j]
                p1 = point(
                    path_values[i * 2] + path_values[count * 4 + i * 2],
                    path_values[i * 2 + 1] + path_values[count * 4 + i * 2 + 1],
                )
                p2 = point(
                    path_values[j * 2] + path_values[count * 2 + j * 2],
                    path_values[j * 2 + 1] + path_values[count * 2 + j * 2 + 1],
                )
                for axis in (0, 1):
                    a = -p0[axis] + 3 * p1[axis] - 3 * p2[axis] + p3[axis]
                    b = 2 * (p0[axis] - 2 * p1[axis] + p2[axis])
                    c = p1[axis] - p0[axis]
                    roots = []
                    if abs(a) < 1e-12:
                        if abs(b) > 1e-12:
                            roots = [-c / b]
                    elif b * b - 4 * a * c >= 0:
                        d = math.sqrt(b * b - 4 * a * c)
                        roots = [(-b - d) / (2 * a), (-b + d) / (2 * a)]
                    for t in roots:
                        if 0 < t < 1:
                            points.append(
                                tuple(
                                    (1 - t) ** 3 * p0[k]
                                    + 3 * (1 - t) ** 2 * t * p1[k]
                                    + 3 * (1 - t) * t * t * p2[k]
                                    + t**3 * p3[k]
                                    for k in (0, 1)
                                )
                            )
        else:
            (x, y), (w, h) = values[:2]
            if draw["kind"] == 0:
                center = point(x, y)
                u, v = point(x + w / 2, y), point(x, y + h / 2)
                radii = [math.hypot(u[k] - center[k], v[k] - center[k]) for k in (0, 1)]
                return center[0] - radii[0], center[1] - radii[1], center[0] + radii[0], center[1] + radii[1]
            radius = min(values[2][0], w / 2, h / 2)
            # A rounded rectangle is the Minkowski sum of its inset rectangle
            # and a radius-r circle; affine support bounds are exact.
            points = [point(x + sx * (w / 2 - radius), y + sy * (h / 2 - radius)) for sx in (-1, 1) for sy in (-1, 1)]
            origin, u, v = point(0, 0), point(radius, 0), point(0, radius)
            rx, ry = [math.hypot(u[k] - origin[k], v[k] - origin[k]) for k in (0, 1)]
            return (
                min(p[0] for p in points) - rx,
                min(p[1] for p in points) - ry,
                max(p[0] for p in points) + rx,
                max(p[1] for p in points) + ry,
            )
        return (
            min(p[0] for p in points),
            min(p[1] for p in points),
            max(p[0] for p in points),
            max(p[1] for p in points),
        )

    def convert(self) -> bytes:
        doc = self.doc
        require(isinstance(doc, dict), "input", "$", "Lottie must be an object")
        if (doc.get("w"), doc.get("h")) != (480, 480) or doc.get("ddd"):
            self.error("<composition>", "only 2D 480x480 compositions are supported", "$")
        if doc.get("assets"):
            self.error("<composition>", "assets/precompositions/images", "$.assets")
        layers = doc.get("layers", [])
        require(
            isinstance(layers, list) and all(isinstance(x, dict) for x in layers),
            "input",
            "$.layers",
            "Expected layer objects",
        )
        for i, layer in enumerate(layers):
            name, path = layer.get("nm", str(i)), f"$.layers[{i}]"
            if layer.get("ty") != 4:
                self.error(name, f"layer type {layer.get('ty')} (only shape layers)", path + ".ty")
            self.scan(layer, path, name)
            self.scan_blur(layer, path, i, layers)
        slots = doc.get("slots", {})
        require(isinstance(slots, dict), "input", "$.slots", "Expected slots object")
        for sid, default in slots.items():
            if SID.fullmatch(sid) is None:
                self.error("<composition>", "invalid slot id", "$.slots." + sid, "slot")
            self.scan(default, "$.slots." + sid, "<composition>")
        if not (
            bounded(doc.get("fr"), 1, 240)
            and bounded(doc.get("ip"), -1e9, 1e9)
            and bounded(doc.get("op"), -1e9, 1e9)
            and doc["ip"] < doc["op"]
        ):
            self.error("<composition>", "invalid fps or composition time", "$", "numeric")
        for i in reversed(range(len(layers))):
            layer, path = layers[i], f"$.layers[{i}]"
            if layer.get("hd"):
                continue
            try:
                self.compile_layer(layer, path, i)
            except AssetError as exc:
                if any(error["code"] == "limit" for error in exc.errors):
                    raise
                for error in exc.errors:
                    self.error(str(layer.get("nm", i)), error["message"], error["path"], error["code"])
            except (ValueError, TypeError, KeyError, IndexError, AttributeError, OverflowError) as exc:
                self.error(str(layer.get("nm", i)), str(exc), path, "input")
        self.check_errors()
        self.draws = [draw for draws in self.paint_draws.values() for draw in draws]
        self.shared_fills()
        self.validate_blur()
        for label, count, limit in (
            ("nodes", len(self.nodes), 32),
            ("draws", len(self.draws), 8),
            ("slots", len(self.slot_dims), 32),
        ):
            if count > limit:
                self.error("<composition>", f"{label} exceeds {limit}", "$", "limit")
        self.check_errors()
        return self.serialize()

    def compile_layer(self, layer: dict[str, Any], path: str, index: int) -> None:
        if layer.get("ty") != 4:
            return
        name = layer.get("nm", str(index))
        if "#glow" in name:
            self.error(name, "#glow is unsupported; use Lottie gradient fills (gf) for light", path + ".nm")
        at = self.node(
            layer.get("ks", {}),
            -1,
            layer["ip"],
            layer["op"],
            layer.get("st", 0),
            layer.get("sr", 1),
            path + ".ks",
            name,
        )
        if self.blur_layer is not None and self.blur_layer["index"] == index:
            self.blur_layer["node"] = at
            self.blur_track = self.prop(
                layer["ef"][0]["ef"][0]["v"], None, path + ".ef[0].ef[0].v", name, (1,), 0, 1024
            )
        self.group(layer["shapes"], at, name, path + ".shapes")

    def serialize(self) -> bytes:
        keys = [k for t in self.tracks for k in t["keys"]]
        slots = list(dict.fromkeys((t["slot"], t["dim"]) for t in self.tracks if t["slot"]))
        offsets = [88]
        counts = (len(self.nodes), len(self.draws), len(self.tracks), len(keys), len(slots))
        for count, stride in zip(counts, (40, 68, 16, 32, 12), strict=True):
            offsets.append(offsets[-1] + count * stride)
        payload, shared = bytearray(), {}

        def put(value: bytes) -> int:
            if value not in shared:
                shared[value] = offsets[-1] + len(payload)
                payload.extend(value)
                payload.extend(b"\0" * (-len(payload) % 4))
            return shared[value]

        key_records = []
        for key in keys:
            vectors = [put(struct.pack(f"<{len(key[v])}f", *key[v])) for v in VECTORS]
            key_records.append(struct.pack("<fI6I", key["t"], key["hold"], *vectors))
        slot_records = [
            struct.pack("<3I", put(name.encode("ascii") + b"\0"), len(name) + 1, dim) for name, dim in slots
        ]
        body = bytearray()
        for n in self.nodes:
            body.extend(struct.pack("<6i4f", n["parent"], *n["tracks"], n["ip"], n["op"], n["start"], n["stretch"]))
        for d in self.draws:
            body.extend(
                struct.pack(
                    "<5I6i2I4i",
                    d["node"],
                    d["kind"],
                    d["vertices"],
                    d["closed"],
                    d["fill"],
                    *d["geo"],
                    d["color"],
                    d["opacity"],
                    d["width"],
                    *d["gradient"],
                )
            )
        first = 0
        for t in self.tracks:
            slot = slots.index((t["slot"], t["dim"])) if t["slot"] else -1
            body.extend(struct.pack("<3Ii", t["dim"], len(t["keys"]), first, slot))
            first += len(t["keys"])
        body.extend(b"".join(key_records))
        body.extend(b"".join(slot_records))
        body.extend(payload)
        fields = [x for pair in zip(offsets[:5], counts, strict=True) for x in pair]
        header = struct.pack(
            "<4s4I3f12IiHH",
            b"SPAF",
            2,
            1,
            88 + len(body),
            0,
            self.doc["fr"],
            self.doc["ip"],
            self.doc["op"],
            *fields,
            offsets[-1],
            len(payload),
            self.blur_track,
            self.blur_draws,
            self.blur_layer["node"] if self.blur_layer else 0,
        )
        blob = bytearray(header + body)
        struct.pack_into("<I", blob, 16, zlib.crc32(blob))
        return bytes(blob)


class Parser(argparse.ArgumentParser):
    def error(self, message: str) -> Never:
        raise AssetError("arguments", "$", message)


def main() -> int:
    parser = Parser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True, parser_class=Parser)
    convert = commands.add_parser("convert")
    convert.add_argument("input", type=Path)
    convert.add_argument("-o", "--output", required=True, type=Path)
    convert.add_argument("--json", action="store_true")
    check = commands.add_parser("inspect")
    check.add_argument("input", type=Path)
    check.add_argument("--json", action="store_true")
    json_output = "--json" in sys.argv[1:]
    try:
        args = parser.parse_args()
        if args.command == "inspect":
            with args.input.open("rb") as stream:
                blob = stream.read(MAX_FILE + 1)
        elif args.input.suffix.lower() == ".json":
            with args.input.open("rb") as stream:
                doc = load_lottie(stream)
            compiler = Lottie(doc)
            blob = compiler.convert()
        else:
            require(
                args.input.suffix.lower() in (".png", ".jpg", ".jpeg", ".gif"),
                "type",
                str(args.input),
                "Expected JSON, PNG, JPEG or GIF",
            )
            blob = convert_image(args.input)
        result = inspect(blob)
        if args.command == "convert":
            # Validation precedes replacement so rejected input cannot destroy a previous asset.
            temp: str | None = None
            try:
                with tempfile.NamedTemporaryFile(dir=args.output.parent, delete=False) as stream:
                    temp = stream.name
                    stream.write(blob)
                os.replace(temp, args.output)
            finally:
                if temp and os.path.exists(temp):
                    os.unlink(temp)
    except AssetError as exc:
        result = {"ok": False, "errors": exc.errors}
    except (
        OSError,
        ValueError,
        TypeError,
        KeyError,
        IndexError,
        AttributeError,
        OverflowError,
        RecursionError,
        struct.error,
        Warning,
    ) as exc:
        result = {"ok": False, "errors": [{"code": "input", "path": "$", "message": str(exc)}]}
    if json_output:
        print(json.dumps(result, ensure_ascii=True))
    elif result["ok"]:
        print(f"{result['kind']}: {result['bytes']} bytes, crc32={result['crc32']}")
        for notice in result["warnings"]:
            print(f"warning {notice['code']}: {notice['message']}", file=sys.stderr)
    else:
        for error in result["errors"]:
            print(f"{error['code']}: {error['path']}: {error['message']}", file=sys.stderr)
    return 0 if result["ok"] else 2


if __name__ == "__main__":
    sys.exit(main())
