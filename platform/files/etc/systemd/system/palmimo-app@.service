[Unit]
Description=Palmimo app %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=palmimo-app
Group=palmimo-apps
SupplementaryGroups=video audio dialout
UMask=0002
WorkingDirectory=/var/lib/palmimo/apps/%i
EnvironmentFile=/run/palmimo/apps/%i/env
Environment=PALMIMO_APP_NAME=%i
Environment=HOME=/var/lib/palmimo/apps/%i
Environment=XDG_CACHE_HOME=/var/lib/palmimo/apps/%i/.cache
Environment=XDG_CONFIG_HOME=/var/lib/palmimo/apps/%i/.config
Environment=XDG_DATA_HOME=/var/lib/palmimo/apps/%i/.local/share
ExecStart=/usr/lib/palmimo/app-launch %i
Restart=no
# `uv run` stays the unit's main process and exits 128+15 when a stop sends
# SIGTERM, which systemd would record as a failed run. A requested stop is clean.
SuccessExitStatus=143
KillMode=control-group
TimeoutStopSec=15
# The app is untrusted and shares the CPU with the Portal; a fork bomb must
# not be able to starve the device of PIDs. No MemoryMax: device RAM varies.
TasksMax=1024

# Filesystem: nothing but the app's own directory and the bind-mounted run
# directory is writable or even visible.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
TemporaryFileSystem=/var/lib/palmimo:ro
BindPaths=/var/lib/palmimo/apps/%i
TemporaryFileSystem=/run/palmimo:ro
BindReadOnlyPaths=/run/palmimo/apps/%i
BindPaths=/run/palmimo/locks
# /proc: an app and a concurrently running palmimo-app-sync@ job share the
# palmimo-app uid, so DAC alone would let either enumerate/inspect the
# other's process via /proc -- these close that. See
# palmimo-app-sync@.service for the uv-cache risk this does NOT cover.
ProtectProc=invisible
ProcSubset=pid

# Devices: closed by default. Portal adds the declared device classes at
# start time via a runtime set-property (see the app-manifest devices field).
DevicePolicy=closed
