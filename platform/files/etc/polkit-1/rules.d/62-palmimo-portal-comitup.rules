// Lets the Portal's own account stop and start comitup, so that after it
// adds or changes a saved Wi-Fi network it can make comitup pick its
// candidates again in priority order (a restart keeps an already-active
// connection instead). Kept separate from 61-palmimo-portal-network.rules so
// the comitup grant can be reasoned about and revoked on its own.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.user !== "user") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.lookup("unit") !== "comitup.service") {
        return polkit.Result.NOT_HANDLED;
    }
    var verb = action.lookup("verb");
    if (verb === "start" || verb === "stop") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
